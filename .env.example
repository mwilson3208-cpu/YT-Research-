# Viewforge configuration
#
# 1. Go to https://console.cloud.google.com/
# 2. Create a project, enable "YouTube Data API v3"
# 3. Create an API key and paste it below
# 4. Copy this file to .env  ->  cp .env.example .env
#
# Without a key the app still runs in DEMO MODE with bundled sample data,
# so every tool and every column is explorable before you add billing details.
YOUTUBE_API_KEY=

# Port for the local server
PORT=4173

# Default region + language used by trend and keyword tools
DEFAULT_REGION=US
DEFAULT_LANGUAGE=en

# Earnings model: USD earned per 1,000 monetized views (RPM range)
RPM_LOW=0.50
RPM_HIGH=6.00
